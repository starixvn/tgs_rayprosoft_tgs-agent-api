<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TGS.Services.Agent</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.10.48">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PagingUtility.AsyncEnumerable" Version="1.1.0" />
    <PackageReference Include="Polly" Version="8.3.1" />
    <PackageReference Include="Scrutor" Version="4.2.2" />
    <PackageReference Include="System.Linq.Async" Version="6.0.1" />
    <PackageReference Include="Tgs.Agent.Client" Version="0.0.35" />
    <PackageReference Include="Tgs.BrandCertificateClient" Version="0.0.29" />
    <PackageReference Include="Tgs.CashService.Client" Version="0.2.9" />
    <PackageReference Include="TGS.Core.Infrastructures.Mail" Version="0.0.6" />
    <PackageReference Include="Tgs.Core.Infrastructures.Security" Version="0.0.2" />
    <PackageReference Include="Tgs.PaymentService.Client" Version="0.8.0" />
    <PackageReference Include="Tgs.PlayerBucket.Client" Version="1.0.0" />
    <PackageReference Include="Tgs.PlayerService.Client" Version="0.2.6" />
    <PackageReference Include="Tgs.Report.Client" Version="0.0.77" />
    <PackageReference Include="TGS.ServiceUtility" Version="0.2.0" />
    <PackageReference Include="TGS.SmsServiceClient" Version="0.0.8" />
    <PackageReference Include="Tgs.ValidateCode.Client" Version="1.1.0" />
    <PackageReference Include="Tgs.VipLevelService.Client" Version="0.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Operations\Operations.csproj" />
    <ProjectReference Include="..\Wallet.Core\Wallet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>