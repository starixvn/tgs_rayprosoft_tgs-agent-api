<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <RepositoryUrl></RepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RootNamespace>UGS.Infrastructures.Redis</RootNamespace>
    <AssemblyName>UGS.Infrastructures.Redis</AssemblyName>
    <Version>4.1.1</Version>
    <Copyright>Copyright ©2018</Copyright>
    <Description>UGS.Infrastructures.Redis</Description>
    <Authors>UGS</Authors>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AssemblyVersion>4.1.1</AssemblyVersion>
    <FileVersion>4.1.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.0.601" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.1' ">
    <PackageReference Include="UGS.Infrastructures.JsonConfig" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="4.4.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\infrastructures-jsonconfig\JsonConfig\JsonConfig.csproj" />
    <ProjectReference Include="..\..\infrastructures-json\Json\Json.csproj" />
    <ProjectReference Include="..\..\infrastructures-oslog\OsLog\OsLog.csproj" />
  </ItemGroup>
</Project>