<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <AssemblyName>TGS.Core.DataServices</AssemblyName>
    <RootNamespace>TGS.Core.DataServices</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DbContextFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="SqlScripts\SP\usp_Brand_GetBrandForCache.sql" />
    <None Remove="SqlScripts\SP\usp_Brand_GetBrandGameProviderConfigurationForCache.sql" />
    <None Remove="SqlScripts\SP\usp_GameProvider_GetCurrenciesByExternalCode.sql" />
    <None Remove="SqlScripts\SP\usp_GameProvider_GetCurrenciesByInternalCode.sql" />
    <None Remove="SqlScripts\SP\usp_GameProvider_GetGameProviderBetLimitCode.sql" />
    <None Remove="SqlScripts\SP\usp_GameProvider_GetGameProviderConfigurationForCache.sql" />
    <None Remove="SqlScripts\SP\usp_GameProvider_GetGameProviderForCache.sql" />
    <None Remove="SqlScripts\SP\usp_GameProvider_GetGameProviderIdByCode.sql" />
    <None Remove="SqlScripts\SP\usp_GameProvider_GetLanguagesByExternalCode.sql" />
    <None Remove="SqlScripts\SP\usp_GameProvider_GetLanguagesByInternalCode.sql" />
    <None Remove="SqlScripts\SP\usp_Player_GetPlayerForCache.sql" />
    <None Remove="SqlScripts\SP\usp_Wallet_GetBalance.sql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SqlScripts\SP\usp_Brand_GetBrandGameProviderConfigurationForCache.sql" />
    <EmbeddedResource Include="SqlScripts\SP\usp_GameProvider_GetLanguagesByExternalCode.sql" />
