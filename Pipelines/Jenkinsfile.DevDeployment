pipeline {
    agent any
	
	environment {
		ENV = "dev"
		TAG = sh(script: "echo ${ENV}-`date +%m%d%H%M`", returnStdout: true).trim()
		Component = 'backoffice-site'
		Registry = "registry.gitlab.com/rayprosoft/turnkey-gaming-system/"
	}
    stages {
		stage('initial') {
			steps {
				script {
					sh 'docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r'
				}
			}
		}
		
		stage('Building image') {
			steps {
				print 'Components:' + params['Components']
				print 'Env:' + params.Env
				
				script {
					def arr = params['Components'].split(",") 
					print 'arr.length : ' + arr.length
					for (i = 1;i <= arr.length; i++) {
						println arr[i]
						def data = "${arr[i]}".split("::")
						
						sh 'docker build -f ${data[0]}/Dockerfile -t ${Registry}${Component}:${TAG} . '
						sh 'docker push ${Registry}${data[1]}:${TAG}'
						
						withKubeConfig([credentialsId: 'k8s-kube-config', serverUrl: 'https://kubernetes.default.svc']) {
							sh "kubectl set image deployment/${data[1]} ${data[1]}=${Registry}${data[1]}:${TAG} --record -n ${params.Env}"
						}
					}					
				}
			}
        }
	}			
}
