pipeline {
    agent any
	environment {
        registry = "registry.gitlab.com/rayprosoft/turnkey-gaming-system"
        registryCredential = 'gitlab-personal-access-token'
        dockerImage = ''
    }
	
	stages {
	    stage('docker login') {
			steps {
				sh  "sudo docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r"  
				echo "dotcover tgs.sln"
			}
		}
		
		stage('Checkout SCM') {
          steps {
            checkout([
              $class: 'GitSCM',
			  branches: [[name: "*/develop" ]],
              userRemoteConfigs: [[
                url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
                credentialsId: 'gitlab-user-pwd',
              ]]
             ])
           }
        }
		stage('Building image') {
			 steps {
				print params['Components']
				script  {
					def arr = params['Components'].split(",")
					for (i in arr) {
						println "now got ${i}"
						def data = i.split("::")
						sh 'sudo docker build -f ' + data[0] + ' -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/' + data[1]+ ':dev .'
						sh 'sudo docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/' + data[1] + ':dev'
					}
				}
			}
		}
    }
}