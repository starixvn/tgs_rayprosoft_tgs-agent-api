pipeline {
    //agent { label 'kubepod'}
	agent any
	environment {
        registry = "registry.gitlab.com/rayprosoft/turnkey-gaming-system"
        registryCredential = 'gitlab-personal-access-token'
        dockerImage = ''
    }
	
	stages {
	    stage('docker login') {
			steps {
				sh  "sudo docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r"  
				echo "dotcover tgs.sln"
			}
		}
		
		stage('Checkout SCM') {
            steps {
				checkout([
					$class: 'GitSCM',
					branches: [[name: "*/develop" ]],
						userRemoteConfigs: [[
						url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
						credentialsId: 'gitlab-user-pwd',
					]]
				])
			}
        }
		
		stage('Deployment') {
			steps {
				print 'Apis:' + params['Apis']
				script  {
					sh 'cd /code/environment/' + params.Env
					def arr = params['Apis'].split(",")
					for (api in arr) {
					
						withKubeConfig([credentialsId: 'k8s-kube-config2', serverUrl: 'https://127.0.0.1:35647']) {
							sh "kubectl apply -f ${api}.yml --record"
						}
	
						//kubernetesDeploy(configs: "${api}.yml", kubeconfigId:"k8s-kube-config2")
					}
				}
			}
		}
    }
}