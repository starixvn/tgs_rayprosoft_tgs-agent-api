pipeline {
    agent any
	
	environment {
		//TAG = "${sh (script: 'git log -1 --pretty=%h', returnStdout: true).trim()}" OK
		//TAG = "${sh (script: 'new Date().format(\''YY-MM-dd_HH-mm\'', TimeZone.getTimeZone('UTC'))', returnStdout: true).trim()}"
		 def TAG = sh(script: "echo `date +%m%d%k%M`", returnStdout: true).trim()
		//script {
		//	set TAG = new Date().format("yyyy-MM-dd_HH-mm")
		//	echo "Tag: ${TAG}"
		//	sh 'docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r'
	    //}

	
		//def TAG = sh(script: "echo `new Date().format('YY-MM-dd_HH-mm', TimeZone.getTimeZone('UTC'))`", returnStdout: true).trim()
		Component = 'backoffice-site'
		
	}
    stages {
		stage('initial') {
			steps {
				script {
					//def now = new Date()
					//TAG = now.format("yyyy-MM-dd_HH-mm")
					//echo "Tag: ${TAG}"
					sh 'docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r'
				}
			}
		}
		
		stage('Checkout SCM') {
			steps {
				script {
					sh 'docker build -f Web/backoffice/Dockerfile -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/${Component}:${TAG} . '
					sh 'docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/${Component}:${TAG}'
				
					withKubeConfig([credentialsId: 'k8s-kube-config', serverUrl: 'https://kubernetes.default.svc']) {
						sh "kubectl set image deployment/${Component} ${Component}=registry.gitlab.com/rayprosoft/turnkey-gaming-system/${Component}:${env.TAG} --record -n dev"
					}
				}
			}
        }
	}			
}
