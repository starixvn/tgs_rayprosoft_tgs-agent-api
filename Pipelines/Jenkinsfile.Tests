pipeline {
    agent any
	
	environment {
		Tag = sh 'git log -1 --pretty=%h'
		Component = 'backoffice-site'
		
	}
    stages {
		stage('initial') {
			steps {
				echo "num : ${sh 'git log -1 --pretty=%h'}"
				sh 'sudo docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r'
			}
		}
		
		stage('Checkout SCM') {
			steps {
				sh 'docker build -f Web\backoffice\Dockerfile -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/${Component}:${Tag} . '
				sh 'docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/${Componen:${Tag}'
				
				withKubeConfig([credentialsId: 'k8s-kube-config', serverUrl: 'https://kubernetes.default.svc']) {
						sh "kubectl set image deployment/${Component} ${Component}=registry.gitlab.com/rayprosoft/turnkey-gaming-system/${Component}:${Tag} --record -n dev"
					}
			}
        }
	}			
}