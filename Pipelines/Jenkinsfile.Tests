pipeline {
    agent any
	
	environment {
		ENV = "dev"
		TAG = sh(script: "echo ${ENV}-`date +%m%d%H%M`", returnStdout: true).trim()
		Component = 'backoffice-site'
		Registry = "registry.gitlab.com/rayprosoft/turnkey-gaming-system/"
	}
    stages {
		stage('initial') {
			steps {
				script {
					//def now = new Date()
					//TAG = now.format("yyyy-MM-dd_HH-mm")
					//echo "Tag: ${TAG}"
					sh 'docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r'
				}
			}
		}
		
		stage('Checkout SCM') {
			steps {
				script {
					sh 'docker build -f Web/backoffice/Dockerfile -t {Registry}${Component}:${TAG} . '
					sh 'docker push {Registry}${Component}:${TAG}'
				
					withKubeConfig([credentialsId: 'k8s-kube-config', serverUrl: 'https://kubernetes.default.svc']) {
						sh "kubectl set image deployment/${Component} ${Component}=${Registry}${Component}:${TAG} --record -n ${ENV}"
					}
				}
			}
        }
	}			
}
