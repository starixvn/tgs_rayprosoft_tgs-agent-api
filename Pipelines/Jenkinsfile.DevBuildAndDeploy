pipeline {
    agent any
	
	environment {
		TAG = sh(script: "echo ${ENV}-`date +%yy%m%d%H%M`", returnStdout: true).trim()
		Registry = "registry.gitlab.com/rayprosoft/turnkey-gaming-system/"
	}
    stages {
		stage ('Drop Database') {
			steps {
				print 'DropDb:' + params['DropDb']
				script {	    
					if (!params['DropDb'].isEmpty()) {
						def arr = params['DropDb'].split(",") 
						for (i = 0;i < arr.length; i++) {
							sh "../dropdb.sh ${arr[i]}"
						}
					}
				}
			}
		}
		
		stage('Building image') {
			steps {
				print 'Components:' + params['Components']
				print 'Env:' + params.Env
				
				script {
					def arr = params['Components'].split(",") 
					print 'arr.length : ' + arr.length
					for (i = 0;i < arr.length; i++) {
						println arr[i]
						def data = arr[i].split("::")
						
						sh "sudo docker build -f ${data[0]}/Dockerfile --build-arg 'BuildConfiguration=Debug' -t ${Registry}${data[1]}:${TAG} ."
						sh "sudo docker push ${Registry}${data[1]}:${TAG}"
						
						withKubeConfig([credentialsId: 'k8s-kube-config', serverUrl: 'https://kubernetes.default.svc']) {
							sh "kubectl set image deployment/${data[2]} ${data[2]}=${Registry}${data[1]}:${TAG} --record -n ${params.Env}"
						}
					}					
				}
			}
        }
	}			
}