pipeline {
    agent any
	
	environment {
		TAG = sh(script: "echo ${ENV}-`date +%Y%m%d%H%M`", returnStdout: true).trim()
		Registry = "registry.gitlab.com/rayprosoft/turnkey-gaming-system/"
		gitlab_user_pwd = credentials('gitlab-user-pwd')
	}
    stages {
        stage('Clone') {
			steps {
				git branch: "develop", url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git' , credentialsId: 'gitlab-user-pwd'
			}
		}
		
		stage ('Drop Database') {
			steps {
				print 'DropDb:' + params['DropDb']
				script {	    
					sh "sudo docker login registry.gitlab.com -u ${gitlab_user_pwd_USR} -p ${gitlab_user_pwd_PSW}"
					if (!params['DropDb'].isEmpty()) {
						def arr = params['DropDb'].split(",") 
						for (i = 0;i < arr.length; i++) {
							sh "../dropdb.sh ${arr[i]}"
						}
					}
				}
			}
		}
		
		stage('Building image') {
			steps {
				print 'Components:' + params['Components']
				print 'Env:' + params.Env
				
				script {
					def arr = params['Components'].split(",") 
					print 'arr.length : ' + arr.length
					for (i = 0;i < arr.length; i++) {
						println arr[i]
						def data = arr[i].split("::")
						
						sh "sudo docker build -f ${data[0]}/Dockerfile -t ${Registry}${data[1]}:${TAG} --secret id=nuget,src=\"/var/lib/jenkins/.nuget/NuGet/NuGet.Config\" ."
						sh "sudo docker push ${Registry}${data[1]}:${TAG}"
						sh "sudo docker push ${Registry}${data[1]}:${ENV}"
						
						withKubeConfig([credentialsId: 'k8s-kube-config', serverUrl: 'https://192.168.50.105:6443']) {
							sh "kubectl set image deployment/${data[2]} ${data[2]}=${Registry}${data[1]}:${TAG} --record -n ${params.Env}"
						}
					}					
				}
			}
        }
	}			
}