def token = "e67339132a7d6490b54ebeac33aa2a6956ebbcaf"
def sonar_url = "http://sonarqube.default:9000"
def sonar_login = "admin"
def sonar_pwd = "1q2w3e4r"


pipeline {
    agent any
    stages {
        stage('Checkout SCM') {
          steps {
              cleanWs()
			  
			  checkout([
				$class: 'GitSCM',
				branches: [[name: "*/develop" ]],
				userRemoteConfigs: [[
					url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
					credentialsId: 'gitlab-user-pwd',
				]]
			])
          }
        }
		
		stage('Build') {
			steps {
				sh "dotnet build tgs.sln"
				echo "build solution"
			}
		}
		
		stage('Test') {
			steps {
				sh  "cd .."  
				sh  "dotnet test tgs.sln --filter Unit /p:CollectCoverage=true"  
				echo "test tgs.sln"
			}
		}
		
		stage('Sonarqube') {
			steps {			
				withSonarQubeEnv('sonar') {		
				    withEnv(['PATH+EXTRA=/var/jenkins_home/.dotnet/tools']) {
						sh "echo $PATH"
						sh "dotnet sonarscanner begin /k:TGS /d:sonar.login=${token}  /d:sonar.host.url=${sonar_url}"  
						sh "dotnet build tgs.sln"
						sh "dotnet sonarscanner end /d:sonar.login=${sonar_login} /d:sonar.password=${sonar_pwd}"
					}
				}
			}
		}
    }
}