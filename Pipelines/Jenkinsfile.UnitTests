pipeline {
    agent any
    environment {
        CI = 'true'
    }
    stages {
		stage('Clean') {
            steps {
                cleanWs()
            }            
        }
		
		stage('Checkout Environment') {
          steps {
            checkout([
              $class: 'GitSCM',
			  branches: [[name: "*/master" ]],
              userRemoteConfigs: [[
                url: 'https://gitlab.com/rayprosoft/environment.git',
                credentialsId: 'gitlab-user-pwd',
              ]]
             ])
           }
        }
		
        stage('Checkout') {
            steps {
			    print "Current Branch: ${env.BRANCH_NAME}"
				sh "git checkout -f ${env.BRANCH_NAME}"
            }
        }
    }
}