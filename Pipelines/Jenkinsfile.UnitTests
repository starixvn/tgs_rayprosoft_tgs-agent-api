		//				sh "echo $PATH"
		//				sh "dotnet sonarscanner begin /k:TGS /d:sonar.login=${token}  /d:sonar.host.url=${sonar_url}"  
		//				sh "dotnet build tgs.sln"
		//				sh "dotnet sonarscanner end /d:sonar.login=${sonar_login_USR} /d:sonar.password=${sonar_login_PSW}"
		//			}
		//		}
		//	}
		//}
    }
}