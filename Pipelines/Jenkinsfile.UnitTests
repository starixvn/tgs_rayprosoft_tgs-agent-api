def token = "e67339132a7d6490b54ebeac33aa2a6956ebbcaf"
def sonar_url = "http://sonarqube.ci:9000"

pipeline {
    agent any
	environment {
		sonar_login = credentials('sonar_login')
	}
	
    stages {
        stage('Checkout SCM') {
          steps {
              cleanWs()
			  
			  checkout([
				$class: 'GitSCM',
				branches: [[name: "*/develop" ]],
				userRemoteConfigs: [[
					url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
					credentialsId: 'gitlab-user-pwd',
				]]
			])
          }
        }
		
		stage('Build') {
			steps {
				sh "dotnet build tgs.sln"
				echo "build solution"
			}
		}
		
		stage('Test') {
			steps {
				sh  "cd .."  
				sh  "dotnet test tgs.sln --filter Unit /p:CollectCoverage=true"  
				echo "test tgs.sln"
			}
		}
		
		//stage('Sonarqube') {
