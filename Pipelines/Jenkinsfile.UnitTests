pipeline {
    agent any
    environment {
        CI = 'true'
    }
    stages {
		stage('Clean') {
            steps {
                cleanWs()
            }            
        }
		
		stage('get_commit_msg') {
			steps {
				script {
					env.GIT_COMMIT_MSG = sh (script: 'git log -1 --pretty=%B ${GIT_COMMIT}', returnStdout: true).trim()
					print "${env.GIT_COMMIT_MSG}"
				}
			}
		}

		stage('Checkout') {
            steps {
			    print "Current Branch: ${env.BRANCH_NAME}"
            }
        }
    }
}