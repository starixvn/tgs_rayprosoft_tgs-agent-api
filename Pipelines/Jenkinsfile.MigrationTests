pipeline {
    agent any
	
	environment {
		gitlab_user_pwd = credentials('gitlab-user-pwd')
	}
	
	parameters {
		gitParameter branchFilter: 'origin/(.*)', defaultValue: 'develop', name: 'BRANCH', type: 'PT_BRANCH'
	}
  
    stages {
	
		stage('Clear') {
			steps {
				cleanWs()
			}
		}
		
		stage('Clone') {
			steps {
				git branch: "${params.BRANCH}", url: "https://${gitlab_user_pwd_USR}:${gitlab_user_pwd_PSW}@gitlab.com/rayprosoft/turnkey-gaming-system.git"
			}
		}
	
		stage('Build') {
			steps {
				sh "dotnet build tgs.sln"
				echo "build solution"
			}
		}
		
		stage('Test') {
			steps {
				sh  "cd .."  
				sh  "dotnet test tgs.sln --filter Unit /p:CollectCoverage=true"  
				echo "test tgs.sln"
			}
		}
    }
}