{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Tgs": "server=localhost;database=Tgs;user=sa;password=1qaz2wsx!@",
    "Bet": "server=localhost;database=Bet;user=sa;password=1qaz2wsx!@",
    "Log": "server=localhost;database=Log;user=sa;password=1qaz2wsx!@",
    "RedisConfigurationString": "localhost,abortConnect=false,connectTimeout=3000"
  },
  "NatsSetting": {
    "Urls": "nats://localhost:4222",
    "ConnectTimeoutMs": 2000,
    "PingInterval": 5000,
    "PingMaxOutStanding": 3,
    "SubscriptionBatchSize": 128
  },
  "NLog": {
    "internalLogLevel": "Info",
    "internalLogFile": ".\internal-nlog.txt",
    "extensions": {
      "NLog.Web.AspNetCore": {
        "assembly": "NLog.Web.AspNetCore"
      }
    },
    "targets": {
      "SQLServer": {
        "type": "Database",
        "connectionString": "c:\\temp\\nlog-all-${shortdate}.log",
        "layout": "${longdate}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Trace",
        "writeTo": "SQLServer"
      },
      {
        "logger": "Microsoft.*",
        "maxLevel": "Info",
        "final": "true"
      }
    ]
  },
  "AllowedHosts": "*"
}
