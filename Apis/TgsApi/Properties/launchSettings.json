{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "TgsApi-RedTiger": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "api/status",
      "environmentVariables": {
        "GameProviderCode": "RT",
        "GameProviderName": "RedTiger",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "https://localhost:62330"
    },
    "TgsApi-Evolution": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "api/status",
      "environmentVariables": {
        "GameProviderCode": "EVO",
        "GameProviderName": "Evolution",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "https://localhost:62331"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/api/status",
      "publishAllPorts": true,
      "useSSL": true
    }
  }
}