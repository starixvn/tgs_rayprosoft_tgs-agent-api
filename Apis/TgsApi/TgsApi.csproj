    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.10.9" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Kubernetes.Tools.Targets" Version="1.1.0" />
    <PackageReference Include="NLog" Version="4.7.4" />
    <PackageReference Include="NLog.Config" Version="4.7.4" />
    <PackageReference Include="NLog.Extensions.Logging" Version="1.6.5" />
    <PackageReference Include="NLog.Schema" Version="4.7.4" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="4.9.3" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\DataServices.Bet\DataServices.Bet.csproj" />
    <ProjectReference Include="..\..\Core\DataServices\DataServices.csproj" />
    <ProjectReference Include="..\..\Core\Infrastructures\Infrastructures.csproj" />
    <ProjectReference Include="..\..\Services\Operations\Operations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.Development.config">
      <DependentUpon>nlog.Development.config</DependentUpon>
    </Content>
  </ItemGroup>


</Project>
