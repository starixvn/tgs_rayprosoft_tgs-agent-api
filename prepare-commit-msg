#!/bin/sh

COMMIT_EDITMSG=$1
 
addBranchName() {
  NAME=$(git branch | grep '*' | sed 's/* //') 
  DESCRIPTION=$(git config branch."$NAME".description)
  TOECHO=""
  if [[ $NAME != "develop" ]] && [[ $NAME != "master" ]]
  then

      #extract prefix and number
      NAME=`expr "$NAME" : '\([^0-9]*[0-9]*\)'`
      TOECHO="$NAME"
      #extract just prefix
      PREFIX=`expr "$NAME" : '\([^0-9]*\)'`
      #extract just NUMBER
      NUMBER=${NAME#$PREFIX}

      REPOURL="$(git config --get remote.origin.url)"
      if [[ $REPOURL == *"turnkey-gaming-system.git" ]]
      then
        TOECHO="TGS-$NUMBER"
      else
        TOECHO=NAME
      fi
  fi 
  
  
  echo "$(cat $COMMIT_EDITMSG)
$TOECHO" > $COMMIT_EDITMSG
  if [ -n "$DESCRIPTION" ] 
  then
     echo "" >> $COMMIT_EDITMSG
     echo $DESCRIPTION >> $COMMIT_EDITMSG
  fi 
}
 
MERGE=$(cat $COMMIT_EDITMSG|grep -i 'merge'|wc -l)
 
if [ $MERGE -eq 0 ] ; then
  addBranchName
fi