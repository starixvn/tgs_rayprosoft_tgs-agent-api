pipeline {
    agent any
	environment {
        registry = "https://registry.gitlab.com"
        registryCredential = 'gitlab-personal-access-token'
        dockerImage = ''
    }
	
    stages {
	    stage('docker login') {
			steps {
				sh  "docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r"  
				echo "dotcover tgs.sln"
			}
		}
        stage('Checkout SCM') {
          steps {
            checkout([
              $class: 'GitSCM',
			  branches: [[name: "*/develop" ]],
              userRemoteConfigs: [[
                url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
                credentialsId: 'gitlab-user-pwd',
              ]]
             ])
           }
        }
		
		stage ('Build docker image for backoffice.site') {
          steps {
                script {
				    sh "pwd"
					sh "ls -l"
					sh "cd Web/backoffice"
					sh "docker build -f Dockerfile -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:0.2.0 ."
					sh "docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:0.2.0"
                }
            }
        }
       
		stage ('Build docker image for backoffice.api'){
		   steps{   
			 script {
				sh "cd ../.."
				sh "docker build -f Apis/BackendOffice/Dockerfile -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-api:0.2.0 ."
				sh "docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-api:0.2.0"
			}
		  }
		}
    }
}