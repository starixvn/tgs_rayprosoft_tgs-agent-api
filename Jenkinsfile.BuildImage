pipeline {
    agent {
        docker {
            image 'maven:3-alpine'
            args '-v $HOME/.m2:/root/.m2'
        }
    }
	environment {
        registry = "https://registry.gitlab.com"
        registryCredential = 'gitlab-personal-access-token'
        dockerImage = ''
    }

	stages {
	    stage('Build') {
            steps {
                sh 'mvn -B'
            }
        }
	    stage('docker login') {
			steps {
				sh  "sudo docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r"  
				echo "dotcover tgs.sln"
			}
		}
        stage('Checkout SCM') {
          steps {
            checkout([
              $class: 'GitSCM',
			  branches: [[name: "*/develop" ]],
              userRemoteConfigs: [[
                url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
                credentialsId: 'gitlab-user-pwd',
              ]]
             ])
           }
        }
		
		stage ('Build docker image for backoffice.site') {
          steps {
                script {
				    sh "pwd"
					sh "ls -l"
					
					docker.withRegistry('https://registry.gitlab.com', 'gitlab-api-token') {
					  def customImage = docker.build("rayprosoft/turnkey-gaming-system/log-api:0.2.0")
						customImage.push()
					}
                }
            }
        }
       
		stage ('Build docker image for backoffice.api'){
		   steps{   
			 script {
				sh "cd ../.."
				sh "sudo docker build -f Apis/BackendOffice/Dockerfile -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-api:0.2.0 ."
				sh "sudo docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-api:0.2.0"
			}
		  }
		}
    }
}