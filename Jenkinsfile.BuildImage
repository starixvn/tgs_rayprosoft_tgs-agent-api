pipeline {
    agent { label 'master' }
	environment {
        registry = "registry.gitlab.com/rayprosoft/turnkey-gaming-system"
        registryCredential = 'gitlab-personal-access-token'
        dockerImage = ''
    }

	stages {
	    stage('docker login') {
			steps {
				sh  "sudo docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p 1q2w3e4r"  
				echo "dotcover tgs.sln"
			}
		}
		
        stage('Checkout SCM') {
          steps {
            checkout([
              $class: 'GitSCM',
			  branches: [[name: "*/develop" ]],
              userRemoteConfigs: [[
                url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
                credentialsId: 'gitlab-user-pwd',
              ]]
             ])
           }
        }
		
		stage('Building image') {
		  steps {
			script {
			   sh 'docker build -f Apis\\BackendOffice\\Dockerfile -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-api:dev .'
			   sh 'docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-api:dev'
			}
		  }
		}
    }
}