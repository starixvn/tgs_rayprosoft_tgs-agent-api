<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <AssemblyName>TGS.Services.BackOffice</AssemblyName>
    <RootNamespace>TGS.Services.BackOffice</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="9.3.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="9.3.0" />
    <PackageReference Include="MediatR" Version="9.0.0" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\DataServices\DataServices.csproj" />
    <ProjectReference Include="..\..\Core\Models\Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Application\Resources\BetLimit.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BetLimit.resx</DependentUpon>
    </Compile>
    <Compile Update="Application\Resources\Brand.Designer.cs">
      <DependentUpon>Brand.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Application\Resources\BrandGame.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BrandGame.resx</DependentUpon>
    </Compile>
    <Compile Update="Application\Resources\BrandGameProviderSchedule - Copy.Designer.cs">
      <DependentUpon>BrandGameProviderSchedule.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Application\Resources\BrandGameProvider.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BrandGameProvider.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Application\Resources\BetLimit.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>BetLimit.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Application\Resources\Brand.resx">
      <LastGenOutput>Brand.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Application\Resources\BrandGame.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>BrandGame.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Application\Resources\BrandGameProvider.resx">
      <LastGenOutput>BrandGameProvider.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Application\Resources\BrandGameProviderSchedule.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>BrandGameProvider.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
