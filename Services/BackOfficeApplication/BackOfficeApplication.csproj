<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <AssemblyName>TGS.Services.BackOfficeApplication</AssemblyName>
    <RootNamespace>TGS.Services.BackOfficeApplication</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\Validators\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="9.0.0" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\DataServices\DataServices.csproj" />
    <ProjectReference Include="..\..\Core\Models\Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Brand.Designer.cs">
      <DependentUpon>Brand.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Brand.resx">
      <LastGenOutput>Brand.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
