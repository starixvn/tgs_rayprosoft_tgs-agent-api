{
  "name": "backoffice",
  "version": "0.0.1",
  "type": "module",
  "config": {},
  "scripts": {
    "start": "npm-run-all --parallel start:*",
    "start:dev": "snowpack dev --reload",
    "start:docker": "docker-compose -f ../../docker-compose.yml up --build --force-recreate --always-recreate-deps --remove-orphans",
    "build": "snowpack build",
    "login:docker": "docker login registry.gitlab.com",
    "postversion": "npm-run-all build:docker push:docker",
    "build:docker": "cross-var docker build . -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:$npm_package_version",
    "push:docker": "cross-var docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:$npm_package_version",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint": "prettier --check \"src/**/*.{js,jsx}\"",
    "tag:docker:dev": "cross-env-shell GIT_COMMIT_HASH=$(git show --no-patch --format=%h) \"npm-run-all build:docker:dev push:docker:dev\"",
    "build:docker:dev": "cross-var docker build . -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:$npm_package_version-$GIT_COMMIT_HASH",
    "push:docker:dev": "docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/backoffice-site:$npm_package_version-$GIT_COMMIT_HASH"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm-run-all tag:docker:dev"
    }
  },
  "dependencies": {
    "react": "^16.13.1",
    "react-dom": "^16.13.1"
  },
  "devDependencies": {
    "@emotion/babel-preset-css-prop": "^10.0.27",
    "@emotion/core": "^10.0.35",
    "@fortawesome/free-regular-svg-icons": "^5.14.0",
    "@fortawesome/free-solid-svg-icons": "^5.14.0",
    "@snowpack/app-scripts-react": "^1.12.6",
    "@testing-library/jest-dom": "^5.11.5",
    "@testing-library/react": "^11.1.1",
    "bumbag": "^1.3.28",
    "clone-deep": "^4.0.1",
    "cross-env": "^7.0.2",
    "cross-var": "^1.1.0",
    "date-fns": "^2.16.1",
    "dayjs": "^1.9.1",
    "dotenv": "^8.2.0",
    "dotenv-cli": "^3.2.0",
    "fast-deep-equal": "^3.1.3",
    "fast-memoize": "^2.5.2",
    "formik": "^2.1.7",
    "husky": "^4.3.0",
    "jest": "^26.4.2",
    "npm-run-all": "^4.1.5",
    "numeral": "^2.0.6",
    "prettier": "^2.1.2",
    "react-datepicker": "^3.3.0",
    "react-router-dom": "^5.2.0",
    "react-table": "^7.6.1",
    "snowpack": "^2.14.3",
    "super-expressive": "^1.4.0",
    "swr": "^0.3.9",
    "tinymce": "^5.5.1"
  }
}
