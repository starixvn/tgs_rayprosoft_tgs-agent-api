{
  "name": "backoffice",
  "version": "0.0.1",
  "config": {},
  "scripts": {
    "start": "npm-run-all --parallel start:*",
    "start:dev": "snowpack dev --reload",
    "start:docker": "docker-compose -f ../../docker-compose.yml up --build --always-recreate-deps --remove-orphans traefik",
    "build": "snowpack build",
    "login:docker": "docker login registry.gitlab.com",
    "build:docker": "cross-var docker build . -t registry.gitlab.com/sam.chuang1/backoffice:$npm_package_version",
    "push:docker": "cross-var docker push registry.gitlab.com/sam.chuang1/backoffice:$npm_package_version",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint": "prettier --check \"src/**/*.{js,jsx}\""
  },
  "husky": {},
  "dependencies": {
    "react": "^16.13.1",
    "react-dom": "^16.13.1"
  },
  "devDependencies": {
    "@emotion/babel-preset-css-prop": "^10.0.27",
    "@emotion/core": "^10.0.35",
    "@fortawesome/free-regular-svg-icons": "^5.14.0",
    "@fortawesome/free-solid-svg-icons": "^5.14.0",
    "@snowpack/app-scripts-react": "^1.9.0",
    "@testing-library/jest-dom": "^5.5.0",
    "@testing-library/react": "^10.0.3",
    "bumbag": "^1.1.6",
    "cross-var": "^1.1.0",
    "dayjs": "^1.8.34",
    "dotenv": "^8.2.0",
    "dotenv-cli": "^3.2.0",
    "fast-memoize": "^2.5.2",
    "formik": "^2.1.5",
    "husky": "^4.2.5",
    "jest": "^26.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.0.5",
    "react-async": "^10.0.1",
    "react-router-dom": "^5.2.0",
    "react-table": "^7.5.0",
    "snowpack": "^2.10.1"
  }
}
