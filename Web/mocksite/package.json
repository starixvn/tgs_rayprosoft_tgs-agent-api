{
  "version": "0.0.1",
  "scripts": {
    "start": "snowpack dev --reload",
    "build": "snowpack build",
    "test": "web-test-runner \"src/**/*.test.jsx\"",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint": "prettier --check \"src/**/*.{js,jsx}\"",
    "tag:docker:dev": "cross-env-shell GIT_COMMIT_HASH=$(git show --no-patch --format=%h) \"npm-run-all build:docker:dev push:docker:dev\"",
    "build:docker:dev": "cross-var docker build . -t registry.gitlab.com/rayprosoft/turnkey-gaming-system/mocksite:$npm_package_version-$GIT_COMMIT_HASH",
    "push:docker:dev": "docker push registry.gitlab.com/rayprosoft/turnkey-gaming-system/mocksite:$npm_package_version-$GIT_COMMIT_HASH"
  },
  "dependencies": {
    "react": "^16.13.1",
    "react-dom": "^16.13.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.12.7",
    "@babel/preset-react": "^7.12.7",
    "@emotion/babel-preset-css-prop": "^11.0.0",
    "@emotion/react": "^11.1.2",
    "@fortawesome/free-solid-svg-icons": "^5.15.1",
    "@snowpack/plugin-babel": "^2.1.5",
    "@snowpack/plugin-dotenv": "^2.0.5",
    "@snowpack/plugin-react-refresh": "^2.3.9",
    "@snowpack/web-test-runner-plugin": "^0.1.5",
    "@testing-library/react": "^11.0.0",
    "@web/test-runner": "^0.9.7",
    "bumbag": "1.6.8",
    "chai": "^4.2.0",
    "cross-env": "^7.0.3",
    "cross-var": "^1.1.0",
    "husky": "^4.3.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.0.5",
    "react-hook-form": "^6.12.2",
    "react-router-dom": "^5.2.0",
    "snowpack": "^2.18.4",
    "swr": "^0.3.9"
  }
}
