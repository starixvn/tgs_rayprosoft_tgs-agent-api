pipeline {
    agent any
    stages {
        stage('Checkout SCM') {
          steps {
		    echo "branch:" + ${params.branch}
            checkout([
              $class: 'GitSCM',
			  branches: [[name: "*/${params.branch}" ]],
              userRemoteConfigs: [[
                url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
                credentialsId: 'gitlab-user-pwd',
              ]]
             ])
           }
        }
		stage('Restore packages'){
			steps{
				sh "dotnet restore tgs.sln"
				echo "restore tgs.sln"
			  }
		}
		stage('Build') {
			steps {
				sh "dotnet build tgs.sln"
				echo "build solution"
			}
		}
		stage('Docker Login') {
			steps {
				sh  "docker login registry.gitlab.com -u lester.wei@rayprosoft.com -p oD2cksJhGN1tgUuaE6C9"  
				echo "test tgs.sln"
			}
		}
		stage('Coder') {
			steps {
				sh  "dotcover()"  
				echo "dotcover tgs.sln"
			}
		}
    }
}