pipeline {
    agent any
    stages {
        stage('Checkout SCM') {
          steps {
            checkout([
              $class: 'GitSCM',
			  branches: [[name: "*/develop" ]],
              userRemoteConfigs: [[
                url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
                credentialsId: 'gitlab-user-pwd',
              ]]
             ])
           }
        }
		stage('Restore packages'){
			steps{
				 withDotNet('dotnetsdk') {
				 	sh "dotnetRestore tgs.sln"
				 }
				echo "restore tgs.sln"
			  }
		}
		stage('Build') {
			steps {
				 withDotNet('dotnetsdk') {
				 	sh "dotnetBuild tgs.sln"
				 }
				echo "build solution"
			}
		}
		stage('Test') {
			steps {
				withDotNet('dotnetsdk') {
					sh  "dotnetTest tgs.sln"  
				}
				echo "test tgs.sln"
			}
		}
    }
}