pipeline {
    agent any
	tools {
	   dotnetsdk 'v1.0.0'
	}
    stages {
        stage('Checkout SCM') {
          steps {
            checkout([
              $class: 'GitSCM',
			  branches: [[name: "*/develop" ]],
              userRemoteConfigs: [[
                url: 'https://gitlab.com/rayprosoft/turnkey-gaming-system.git',
                credentialsId: 'gitlab_userpwd',
              ]]
             ])
           }
        }
		stage('Restore packages'){
			steps{
				sh "dotnetRestore tgs.sln"
				echo "restore tgs.sln"
			  }
		}
		stage('Build') {
			steps {
				sh "dotnetBuild tgs.sln"
				echo "build solution"
			}
		}
		stage('Test') {
			steps {
				sh  "dotnetTest tgs.sln"  
				echo "test tgs.sln"
			}
		}
    }
}