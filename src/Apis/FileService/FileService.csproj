<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <UserSecretsId>30a457ed-c0fd-46c9-bd7e-2ef259ac9187</UserSecretsId>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <RootNamespace>TGS.Apis.FileService</RootNamespace>
    <AssemblyName>TGS.Apis.FileService</AssemblyName>
    <GlobalNugetConfig>$(UserProfile)\AppData\Roaming\NuGet\NuGet.Config</GlobalNugetConfig>
    <GlobalNugetConfig Condition="'$(UserProfile)'==''">~/.nuget/NuGet/NuGet.Config</GlobalNugetConfig>
    <DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)" --secret id=nuget,src="$(GlobalNugetConfig)"</DockerfileBuildArguments>
    <DockerfileTag Condition="$(DockerfileTag) == ''">fileservice-api</DockerfileTag>
  </PropertyGroup>

  <PropertyGroup>
    <DocumentationFile>obj\TGS.Apis.FileService.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DataService\EntityTypeConfigurations\**" />
    <Compile Remove="UploadImages\**" />
    <Content Remove="DataService\EntityTypeConfigurations\**" />
    <Content Remove="UploadImages\**" />
    <Compile Remove="Properties\GlobalAssemblyInfo.cs" />
    <Compile Include="..\..\GlobalAssemblyInfo.cs">
      <Link>GlobalAssemblyInfo.cs</Link>
    </Compile>
    <EmbeddedResource Remove="DataService\EntityTypeConfigurations\**" />
    <EmbeddedResource Remove="UploadImages\**" />
    <None Remove="DataService\EntityTypeConfigurations\**" />
    <None Remove="UploadImages\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="9.5.3" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="9.5.3" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.10.13" />
    <PackageReference Include="MongoDB.Driver" Version="2.12.3" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="16.9.60">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="prometheus-net.AspNetCore" Version="4.1.1" />
    <PackageReference Include="prometheus-net.AspNetCore.HealthChecks" Version="4.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.1.4" />
    <PackageReference Include="System.Reactive" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Infrastructures\Infrastructures.csproj" />
    <ProjectReference Include="..\..\Repositories\MongoFileMetaRepository\MongoFileMetaRepository.csproj" />
    <ProjectReference Include="..\..\Services\FileService.Core\FileService.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\File.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>File.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\File.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>File.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
