{
  "Notify": {
    "Url": "https://notify.tgsdev.gq",
    "Path": "telegram/dev/log-alert"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LoggerServiceConfig": {
    "BatchInsertWaitingSeconds": 1,
    "BatchInsertCounts": 1,
    "LogLevel": "ALL",
    "UnrestrictedLoggers": []
  },
  "AllowedHosts": "*"
}
