<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <AssemblyName>TGS.Workers.Schedulers</AssemblyName>
    <RootNamespace>TGS.Workers.Schedulers</RootNamespace>
    <GlobalNugetConfig>$(UserProfile)\AppData\Roaming\NuGet\NuGet.Config</GlobalNugetConfig>
    <GlobalNugetConfig Condition="'$(UserProfile)'==''">$(HOME)/.nuget/NuGet/NuGet.Config</GlobalNugetConfig>
    <DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)" --secret id=nuget,src="$(GlobalNugetConfig)"</DockerfileBuildArguments>
    <DockerfileTag Condition="$(DockerfileTag) == ''">scheduler</DockerfileTag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.7.28" />
    <PackageReference Include="Hangfire.Console" Version="1.4.2" />
    <PackageReference Include="Hangfire.Dashboard.Management" Version="1.7.9" />
    <PackageReference Include="Hangfire.Redis.StackExchange" Version="1.8.5" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.15.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="5.0.2" />
    <PackageReference Include="prometheus-net.AspNetCore.HealthChecks" Version="5.0.2" />
    <PackageReference Include="TGS.Core.Infrastructures.Mail" Version="0.0.6" />
    <PackageReference Include="Tgs.ProfitRebate.Client" Version="1.0.17" />
    <PackageReference Include="Tgs.Report.Aggregate.Client" Version="0.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Repositories\GameProviders.Repositories\GameProviders.Repositories.csproj" />
    <ProjectReference Include="..\..\Services\BackOffice\BackOffice.csproj" />
    <ProjectReference Include="..\..\Services\Operations\Operations.csproj" />
    <ProjectReference Include="..\..\Shared\Game.ApiClients\Game.ApiClients.csproj" />
  </ItemGroup>

</Project>
