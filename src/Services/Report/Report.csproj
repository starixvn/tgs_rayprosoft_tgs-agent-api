<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <AssemblyName>TGS.Services.Report</AssemblyName>
    <RootNamespace>TGS.Services.Report</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Application\Queries\Promotion\**" />
    <Compile Remove="Application\Queries\ReportHandlers\**" />
    <Compile Remove="Domain\**" />
    <EmbeddedResource Remove="Application\Queries\Promotion\**" />
    <EmbeddedResource Remove="Application\Queries\ReportHandlers\**" />
    <EmbeddedResource Remove="Domain\**" />
    <None Remove="Application\Queries\Promotion\**" />
    <None Remove="Application\Queries\ReportHandlers\**" />
    <None Remove="Domain\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="TGS.ServiceUtility" Version="0.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Clients\Report.Client\Report.Client.csproj" />
    <ProjectReference Include="..\..\Core\DataServices.Tgs\DataServices.Tgs.csproj" />
    <ProjectReference Include="..\..\Repositories\TgsTransaction.Repositories\TgsTransaction.Repositories.csproj" />
    <ProjectReference Include="..\Bucket\PlayerBucket.Core.csproj" />
    <ProjectReference Include="..\PluggableServices\PluggableServices.csproj" />
    <ProjectReference Include="..\Promotion.Core\Promotion.Core.csproj" />
    <ProjectReference Include="..\TgsTransaction.Core\TgsTransaction.Core.csproj" />
    <ProjectReference Include="..\Wallet.Core\Wallet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Application\Resources\Agent.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Agent.resx</DependentUpon>
    </Compile>
    <Compile Update="Application\Resources\Player.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Player.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Application\Resources\Agent.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Agent.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Application\Resources\Player.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Player.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
